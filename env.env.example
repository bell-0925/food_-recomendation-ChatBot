GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 사용할 LLM 프로바이더 (gemini | openai | claude)
LLM_PROVIDER=gemini
LLM_MODEL=models/gemini-2.5-flash-lite

CHATBOT_MAX_HISTORY=10
CHATBOT_SYSTEM_PROMPT_PATH=chatbot/prompts/system.md

# 데이터 소스 (sqlite | api)
DATA_SOURCE=sqlite
DATABASE_URL=sqlite:///data/lunch_chatbot.db
